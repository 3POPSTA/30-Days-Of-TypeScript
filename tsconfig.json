{
  "include": ["src/**/*", "*_Day_*/**/*", "data/**/*"],
  "exclude": ["node_modules", "build", "scripts"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./build",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}