{
  "name": "30-days-of-typescript",
  "version": "1.0.0",
  "description": "30 Days of TypeScript: An interactive Zero to Hero challenge with lessons, tiered exercises, solutions, and production best practices",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "tutor": "tsx src/index.ts",
    "test": "tsx src/index.ts --test",
    "verify": "tsx src/index.ts --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "day:01": "tsx 01_Day_Introduction/lesson.ts",
    "day:02": "tsx 02_Day_Primitive_types/lesson.ts",
    "day:03": "tsx 03_Day_Special_types/lesson.ts",
    "day:04": "tsx 04_Day_Arrays/lesson.ts",
    "day:05": "tsx 05_Day_Tuples/lesson.ts",
    "day:06": "tsx 06_Day_Objects/lesson.ts",
    "day:07": "tsx 07_Day_Type_aliases/lesson.ts",
    "day:08": "tsx 08_Day_Unions_and_literals/lesson.ts",
    "day:09": "tsx 09_Day_Type_narrowing/lesson.ts",
    "day:10": "tsx 10_Day_Type_predicates/lesson.ts",
    "day:11": "tsx 11_Day_Discriminated_unions/lesson.ts",
    "day:12": "tsx 12_Day_Functions/lesson.ts",
    "day:13": "tsx 13_Day_Function_overloading/lesson.ts",
    "day:14": "tsx 14_Day_Interfaces/lesson.ts",
    "day:15": "tsx 15_Day_Interface_vs_type/lesson.ts",
    "day:16": "tsx 16_Day_Classes/lesson.ts",
    "day:17": "tsx 17_Day_Abstract_classes/lesson.ts",
    "day:18": "tsx 18_Day_Enums/lesson.ts",
    "day:19": "tsx 19_Day_Generics_basics/lesson.ts",
    "day:20": "tsx 20_Day_Generics_constraints/lesson.ts",
    "day:21": "tsx 21_Day_Generic_classes/lesson.ts",
    "day:22": "tsx 22_Day_Keyof_and_indexed_access/lesson.ts",
    "day:23": "tsx 23_Day_Mapped_types/lesson.ts",
    "day:24": "tsx 24_Day_Template_literal_types/lesson.ts",
    "day:25": "tsx 25_Day_Conditional_types/lesson.ts",
    "day:26": "tsx 26_Day_The_infer_keyword/lesson.ts",
    "day:27": "tsx 27_Day_Utility_types_part_1/lesson.ts",
    "day:28": "tsx 28_Day_Utility_types_part_2/lesson.ts",
    "day:29": "tsx 29_Day_Async_and_error_handling/lesson.ts",
    "day:30": "tsx 30_Day_Final_capstone_project/lesson.ts"
