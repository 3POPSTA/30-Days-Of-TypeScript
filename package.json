  "keywords": [
    "typescript",
    "30-days-of-typescript",
    "30-days-of-code",
    "zero-to-hero",
    "learn-typescript",
    "interactive",
    "exercises",
    "generics",
    "type-gymnastics",
    "utility-types"
  ],
  "author": "TypeScript Tutor Community",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
